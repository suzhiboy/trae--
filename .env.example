# 服务端环境变量示例。复制为 .env（已被 .gitignore 忽略），不要把真实密钥提交到仓库。
# 火山方舟 OpenAI 兼容接口，官方文档：https://ark.volcengine.com/region:cn-beijing/docs/quick-start
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 文本诊断模型 ID，请从火山方舟控制台模型列表填写；不要写死在前端。
AI_MODEL=

# 图片识别模型 ID；留空时回退到 AI_MODEL。应选择支持多模态理解的模型。
AI_VISION_MODEL=

# 只放在服务端环境变量中，不要进入前端构建产物或 git。
AI_API_KEY=

# 可选：模型超时，单位毫秒。
AI_TIMEOUT_MS=20000
AI_VISION_TIMEOUT_MS=20000
AI_FALLBACK_TIMEOUT_MS=8000
