# 服务端环境变量示例。复制为 .env（已被 .gitignore 忽略），不要把真实密钥提交到仓库。
# 启动：node --env-file=.env server.mjs（Node.js 20.6+），或直接在部署平台注入环境变量。
# Key 只放在服务端环境变量里；页面上的自定义 Key 只存在用户当前页面内存。

# ---------------------------------------------------------------------------
# 示例 1：保留原有火山方舟配置（旧变量，升级后原样可用）
# ---------------------------------------------------------------------------
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 文本诊断模型 ID。必填；模型 ID 以火山方舟控制台当前模型/接入点列表为准。
# 火山方舟的接入点 ID 通常形如 ep-2024xxxx；也可以填控制台给出的模型名称。
AI_MODEL=

# 可选：服务商显示名。留空时按 AI_BASE_URL 自动推导（火山方舟、OpenAI 等）。
AI_PROVIDER_NAME=

# 图片识别模型 ID；留空时回退到 AI_MODEL。应选择支持多模态理解的模型。
AI_VISION_MODEL=

# 可选：站点默认 Key。留空时站点模式不可用，但用户仍可在页面「AI 设置」里填写自己的 Key。
AI_API_KEY=

# 可选：旧变量协议。默认 openai；只有确实使用 Anthropic Messages 时才改为 anthropic。
# AI_PROTOCOL=openai
# 可选：旧变量 JSON 模式。默认 json_object；不支持 response_format 时改为 none。
# AI_JSON_MODE=json_object
# 可选：旧变量供应商 id。默认 default；一般不需要修改。
# AI_PROVIDER_ID=default

# ---------------------------------------------------------------------------
# 示例 2：用户自带 DeepSeek / OpenAI / Claude Key
# ---------------------------------------------------------------------------
# 不需要在这里填写这三家的 Key。服务端启动后，页面「AI 设置 → 使用自己的 Key」
# 会列出内置的火山方舟、DeepSeek、OpenAI、Anthropic（Claude）入口。
# 用户选择供应商、确认模型 ID（可手填或点「读取模型列表」）、填写自己的 Key，
# 点击「启用 → 测试连接」后即可使用。刷新页面后 Key 清除，需要重新填写。
#
# 旧版前端仍依赖 AI_MODEL 才能开启自定义模式；如果还要兼容旧前端，可以只配置
# 一个默认模型而不配置 AI_API_KEY：
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=<默认文本模型或接入点 ID>
#
# 模型 ID 从哪里取得：
# - DeepSeek：控制台/文档中的模型名称，例如 deepseek-chat、deepseek-reasoner。
# - OpenAI：控制台/文档中的模型名称，例如 gpt-4o-mini、gpt-4o；以账号可用列表为准。
# - Anthropic：控制台/文档中的模型名称，例如 claude-sonnet-4-5；以账号可用列表为准。
# - 火山方舟：控制台创建的接入点 ID（ep-...）或模型名称。

# ---------------------------------------------------------------------------
# 示例 3：管理员添加中转站（可带路径前缀）
# ---------------------------------------------------------------------------
# AI_PROVIDERS 是 JSON 数组；新增同协议中转站只需要增加一项配置。
# 字段说明：
#   id          公开标识，只能用小写字母、数字、-、_；浏览器提交它，服务端据此查配置
#   label       页面显示名称
#   protocol    openai（Chat Completions）或 anthropic（原生 Messages）
#   baseUrl     必须是 HTTPS；仅本机回环地址允许 HTTP。会保留 /v1、/api/v3 或自定义前缀
#   textModels  该供应商的文本模型范围；第一个是站点模式默认值
#   visionModels 图片模型范围；留空时站点模式回退到文本模型
#   apiKey      可选，站点默认 Key；留空表示只能由用户自带 Key
#   customKey   是否允许用户自带 Key，默认 true
#   jsonMode    openai 协议可选 json_object（确认支持 response_format 时）或 none（默认）
#   maxTokens   可选，默认 3000
#   temperature 可选，默认 0.1；填 null 表示不发送 temperature
#   default     是否设为默认供应商
#
# 下面的示例是一个“模型别名含 claude、但暴露 OpenAI 兼容接口”的中转站。
# 注意：模型名里有 claude 不代表协议是 Anthropic；这里按中转站声明的 openai 调用。
# AI_PROVIDERS=[{"id":"campus-relay","label":"校园中转站","protocol":"openai","baseUrl":"https://relay.example.edu.cn/ai/v1","textModels":["claude-sonnet-4-5-relay"],"visionModels":[],"apiKey":"","customKey":true,"jsonMode":"none","default":false}]
#
# 如果中转站声明的是 Anthropic 协议，则这样写：
# AI_PROVIDERS=[{"id":"claude-relay","label":"Claude 中转","protocol":"anthropic","baseUrl":"https://relay.example.com/anthropic","textModels":["claude-sonnet-4-5"],"visionModels":["claude-sonnet-4-5"],"apiKey":"","customKey":true,"default":false}]
#
# 站点模式需要站点 Key 时，可以在对应项里填写 apiKey（仍然只在服务端环境变量中）：
# AI_PROVIDERS=[{"id":"site-relay","label":"校内站点中转","protocol":"openai","baseUrl":"https://relay.example.edu.cn/v1","textModels":["school-model"],"visionModels":["school-vision"],"apiKey":"<服务端密钥>","customKey":true,"default":true}]

# ---------------------------------------------------------------------------
# 可选：超时设置（毫秒）
# ---------------------------------------------------------------------------
AI_TIMEOUT_MS=20000
AI_VISION_TIMEOUT_MS=20000
AI_FALLBACK_TIMEOUT_MS=8000
AI_TEST_TIMEOUT_MS=15000
AI_MODELS_TIMEOUT_MS=10000
